# Copy to .env and fill in real values before running anything here.
# This file lists names only — no secrets, no real hostnames.
# The four process images build from this tree. Empty secrets make them exit.
# v0.0.1 does not contain them. This file has names only.

# --- identity ---
OWNER_NAME=
OWNER_TIMEZONE=

# --- LLM ---
# Set exactly one provider key. See docs/architecture.md.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_THINK=
MODEL_FAST=

# --- memory ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
OLLAMA_URL=http://ollama:11434
POSTGRES_HOST=postgres
POSTGRES_DB=memories
POSTGRES_USER=
POSTGRES_PASSWORD=
MEMORY_TOKEN=

# --- board / dashboard ---
BOARD_PASSWORD=
BOARD_APPROVAL_TOKEN=
FRIDAY_NOTIFY_TOKEN=

# --- optional: mattermost door ---
MATTERMOST_ENABLED=0

# --- optional: cloudflare tunnel ---
CLOUDFLARE_ENABLED=0
CLOUDFLARE_TUNNEL_TOKEN=

# --- optional: headscale mesh ---
# Setup can leave the Board on this computer, join an existing Headscale,
# or run Headscale on this computer. The dev compose.yml does not start
# either one. The image compose starts the client only after that choice.
# Nothing in this file is a real control URL.
HEADSCALE_ENABLED=0
HEADSCALE_URL=
