# Copy to .env and fill in real values before running anything here.
# This file lists names only — no secrets, no real hostnames.
# NOTE: this repo is experimental scaffolding; nothing here is a tested runtime yet.

# --- identity ---
OWNER_NAME=
OWNER_TIMEZONE=

# --- LLM ---
# Set exactly one provider key. See docs/architecture.md.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_THINK=
MODEL_FAST=

# --- memory ---
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434
POSTGRES_HOST=postgres
POSTGRES_DB=memories
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- board / dashboard ---
BOARD_PASSWORD=

# --- optional: mattermost door ---
MATTERMOST_ENABLED=0

# --- optional: cloudflare tunnel ---
CLOUDFLARE_ENABLED=0
CLOUDFLARE_TUNNEL_TOKEN=

# --- optional: headscale mesh ---
# Unused until build-order step 7 adds the mesh profile. compose.yml has
# no Headscale service yet, and nothing in this repo reads HEADSCALE_URL.
HEADSCALE_ENABLED=0
HEADSCALE_URL=
